          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "textMode": "auto",
          "wideLayout": true
        },
        "targets": [
          {"editorMode": "code", "expr": "zava_queue_latency_quantile_seconds{quantile=\"0.95\"}", "instant": true, "legendFormat": "p95", "refId": "A"}
        ],
        "title": "Queue latency p95",
        "type": "stat"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 0.001}
              ]
            },
            "unit": "ops"
          },
          "overrides": []
        },

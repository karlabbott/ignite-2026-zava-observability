        "type": "stat"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisLabel": "",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 15,
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {"group": "A", "mode": "none"}
            },
            "unit": "ops"
          },
          "overrides": []
        },
        "gridPos": {"h": 9, "w": 16, "x": 0, "y": 5},
        "id": 7,
        "options": {
          "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
          "tooltip": {"mode": "multi", "sort": "desc"}
        },
        "targets": [
          {"editorMode": "code", "expr": "zava:work_arrivals_per_minute", "legendFormat": "Arrivals/min", "refId": "A"},
          {"editorMode": "code", "expr": "zava:work_completions_per_minute", "legendFormat": "Completions/min", "refId": "B"},
          {"editorMode": "code", "expr": "zava_queue_depth", "legendFormat": "Backlog", "refId": "C"}
        ],
        "title": "Are shipments moving fast enough?",
        "type": "timeseries"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "CREATED"},
              "properties": [{"id": "color", "value": {"fixedColor": "gray", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "PICKED_UP"},
              "properties": [{"id": "color", "value": {"fixedColor": "light-blue", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "IN_TRANSIT"},
              "properties": [{"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "AT_HUB"},
              "properties": [{"id": "color", "value": {"fixedColor": "orange", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "OUT_FOR_DELIVERY"},
              "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "DELIVERED"},
              "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byName", "options": "EXCEPTION"},
              "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]
            }
          ]
        },
        "gridPos": {"h": 9, "w": 8, "x": 16, "y": 5},
        "id": 8,
        "options": {
          "displayLabels": ["name", "value"],
          "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
          "pieType": "donut",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
        },
        "targets": [
          {"editorMode": "code", "expr": "zava_shipments", "instant": true, "legendFormat": "{{status}}", "refId": "A"}
        ],
        "title": "Shipment status distribution",
        "type": "piechart"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 20,
              "lineWidth": 2,
              "showPoints": "never",
              "stacking": {"group": "A", "mode": "normal"}
            },
            "unit": "ops"
          },
          "overrides": []
        },
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
        "id": 9,
        "options": {
          "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
          "tooltip": {"mode": "multi", "sort": "desc"}
        },
        "targets": [
          {"editorMode": "code", "expr": "zava:worker_completions_per_minute{worker_site=\"azure/westus2\"}", "legendFormat": "{{worker_host}} / {{worker_site}}", "refId": "A"}
        ],
        "title": "Live Azure worker contribution",
        "type": "timeseries"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 20},
                {"color": "red", "value": 30}
              ]
            },
            "unit": "s"
          },
          "overrides": []
        },
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
        "id": 10,
        "options": {
          "displayMode": "gradient",
          "minVizHeight": 10,
          "minVizWidth": 0,
          "orientation": "horizontal",
          "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
          "showUnfilled": true,
          "valueMode": "color"
        },
        "targets": [
          {"editorMode": "code", "expr": "zava_tier_heartbeat_age_seconds{platform=\"Azure\",location=\"azure/westus2\"}", "instant": true, "legendFormat": "{{tier}} / {{hostname}}", "refId": "A"}
        ],
        "title": "Live Azure tier heartbeat age",
        "type": "bargauge"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisCenteredZero": false,
              "axisColorMode": "text",
              "axisPlacement": "auto",
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {"group": "A", "mode": "none"}
            },
            "unit": "percentunit"
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": "^rhel /"},
              "properties": [{"id": "color", "value": {"fixedColor": "#EE0000", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "^sles /"},
              "properties": [{"id": "color", "value": {"fixedColor": "#30BA78", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "^ubuntu /"},
              "properties": [{"id": "color", "value": {"fixedColor": "#E95420", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "^rocky /"},
              "properties": [{"id": "color", "value": {"fixedColor": "#10B981", "mode": "fixed"}}]
            },
            {
              "matcher": {"id": "byRegexp", "options": "^azurelinux /"},
              "properties": [{"id": "color", "value": {"fixedColor": "#0078D4", "mode": "fixed"}}]
            }
          ]
        },
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
        "id": 11,
        "options": {
          "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
          "tooltip": {"mode": "multi", "sort": "desc"}
        },
        "targets": [
          {
            "editorMode": "code",
            "expr": "1 - avg by (distro, host, tier) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
            "legendFormat": "{{distro}} / {{tier}} / {{host}}",
            "refId": "A"
          }
        ],
        "title": "CPU utilization by tier",
        "type": "timeseries"
      }

#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"
duration="${2:-180}"
db_address="${3:-{{ zava_db_address }}}"
db_port="${4:-{{ zava_sql_port }}}"

if [[ ! "${duration}" =~ ^[0-9]+$ ]] || (( duration < 30 || duration > 600 )); then
  echo "duration must be an integer between 30 and 600 seconds" >&2
  exit 2
fi

run_capture() {
  local unit="$1"
  local evidence="$2"
  local gadget="$3"
  local scope="$4"
  shift 4
  local scope_arguments=()
  if [[ "${scope}" == "host" ]]; then
    scope_arguments+=(--host)
  fi
  systemctl stop "${unit}.service" >/dev/null 2>&1 || true
  systemd-run \
    --unit="${unit}" \
    --collect \
    --property=Type=exec \
    --property=TimeoutStopSec=10 \
    /usr/local/sbin/zava-ig-export \
      --evidence "${evidence}" \
      --metrics-file "{{ inspektor_gadget_metrics_directory }}/zava_ig_${evidence}.prom" \
      -- \
      /usr/local/bin/ig run "${gadget}" "${scope_arguments[@]}" -o json "$@"
}

case "${action}" in
  tcp)
    run_capture zava-ig-tcp tcp \
      "trace_tcp:v{{ inspektor_gadget_version }}" host \
      --connect-only --failure-only --timeout "${duration}"
    echo "Tracing failed TCP connections; focus on ${db_address}:${db_port}."
    ;;
  process)
    run_capture zava-ig-signal process_signal \
      "trace_signal:v{{ inspektor_gadget_version }}" host \
      --timeout "${duration}"
    run_capture zava-ig-exec process_exec \
      "trace_exec:v{{ inspektor_gadget_version }}" host \
      --paths --timeout "${duration}"
    echo "Tracing process signals and executions."
    ;;
  blockio)
    run_capture zava-ig-blockio blockio \
      "profile_blockio:v{{ inspektor_gadget_version }}" default \
      --timeout "${duration}"
    echo "Profiling block-device latency."
    ;;
  dns)
    run_capture zava-ig-dns dns \
      "trace_dns:v{{ inspektor_gadget_version }}" host \
      --timeout "${duration}"
    echo "Tracing DNS requests and responses."
    ;;
  *)
    echo "usage: $0 {tcp|process|blockio|dns} [duration] [db_address] [db_port]" >&2
    exit 2
    ;;
esac

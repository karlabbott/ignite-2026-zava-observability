global:
  scrape_interval: 10s
  evaluation_interval: 10s
  external_labels:
    estate: zava
    environment: ignite

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: zava-business
    static_configs:
      - targets:
          - "{{ zava_api_address }}:9108"
        labels:
          tier: api
          host: sles-api

  - job_name: zava-linux
    static_configs:
      - targets: ["{{ zava_db_address }}:9100"]
        labels:
          tier: db
          host: rhel-db
          distro: rhel
      - targets: ["{{ zava_api_address }}:9100"]
        labels:
          tier: api
          host: sles-api
          distro: sles
      - targets: ["{{ zava_web_address }}:9100"]
        labels:
          tier: web
          host: ubuntu-web
          distro: ubuntu
      - targets: ["{{ zava_worker_address }}:9100"]
        labels:
          tier: worker
          host: ciq-rocky-worker
          distro: rocky

remote_write:
  - url: "{{ zava_prometheus_remote_write_url }}"
    azuread:
      cloud: AzurePublic
      managed_identity:
        client_id: ""
    queue_config:
      capacity: 10000
      max_shards: 4
      min_shards: 1
      max_samples_per_send: 2000
      batch_send_deadline: 5s

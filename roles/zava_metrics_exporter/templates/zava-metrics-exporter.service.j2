[Unit]
Description=Zava business metrics exporter
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ zava_application_environment_file }}

[Service]
User={{ zava_metrics_exporter_user }}
Group={{ zava_metrics_exporter_user }}
EnvironmentFile={{ zava_application_environment_file }}
Environment=ZAVA_EXPORTER_PORT={{ zava_metrics_exporter_port }}
Environment=ZAVA_STUCK_WORK_THRESHOLD_SECONDS={{ zava_stuck_work_threshold_seconds }}
ExecStart={{ zava_metrics_exporter_root }}/venv/bin/python {{ zava_metrics_exporter_root }}/exporter.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths={{ zava_application_environment_file }}
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
